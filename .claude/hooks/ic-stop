#!/usr/bin/env bash
# ic-stop -- schema-5 stop gate for the one inquiry spine.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PAYLOAD="$(cat)"

block() {
    printf '{"decision":"block","reason":"%s"}\n' \
        "$(printf '%b' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
             | awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; print }')"
    exit 0
}

if ! printf '%s' "$PAYLOAD" | node -e '
const fs = require("node:fs");
try {
  const value = JSON.parse(fs.readFileSync(0, "utf8"));
  if (value === null || Array.isArray(value) || typeof value !== "object") process.exit(1);
} catch { process.exit(1); }
'; then
    block "Malformed stop-hook payload; lawful inquiry state cannot be established."
fi

if ! lifecycle="$(bash "$HERE/ic-trace" state 2>&1)"; then
    block "The active trace is malformed or unreadable: ${lifecycle}"
fi
schema="$(printf '%s' "$lifecycle" | node -e '
const fs=require("fs");process.stdout.write(String(JSON.parse(fs.readFileSync(0,"utf8")).schema??""));
')"
[ "$schema" = "5" ] || block "Only the consolidated schema-5 inquiry spine is live. Preserve older evidence in Git and create an explicit schema-5 migration trace."

if ! trace_status="$(bash "$HERE/ic-trace" status 2>&1)"; then
    block "The active inquiry trace is malformed or unreadable. Preserve it as ancestry rather than rewriting it.\n\n${trace_status}"
fi

if bash "$HERE/ic-trace" open >/dev/null 2>&1; then
    block 'An inquiry occurrence is unresolved. Complete RETURN through Raw, Interpret, Check, Answer, and Reify, then regenerate FIELD before ending the turn.'
fi

if bash "$HERE/ic-trace" stop-pending >/dev/null 2>&1; then
    block 'The active field has no challenged task-level closure and lawful stop. A checkpoint is replayable progress, not task completion. Continue the executable Frontier or record an explicitly supported partial stop state after closure.'
fi

exit 0
