#!/usr/bin/env bash
# ic-inject -- UserPromptSubmit reminder and exact live-frontier projection.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cat >/dev/null

STATUS="$(bash "$HERE/ic-trace" status 2>&1 | sed 's/^/  /')"
FRONTIER="$ROOT/IMPLEMENTATION_FRONTIER.md"
if BLOCK="$(node "$HERE/ic-frontier.js" "$FRONTIER" block 2>&1)"; then
    :
else
    BLOCK="INVALID: ${BLOCK#ic-frontier: }"
fi

CONTEXT="INQUIRY HARNESS ACTIVE -- consequential work runs the engineering clock.

  SPECIFY -> INSPECT -> CONTRAST -> TRACE -> EXPERIMENT -> UPDATE
  -> CHANGE -> VERIFY -> CHALLENGE -> MINIMIZE -> RATCHET

  Explicit user tasks may temporarily supersede the persistent Frontier.
  Before mutation: probe actuality, name the protected difference and smallest
  wrong implementation, then seal the prediction.
  After mutation: preserve the raw return, check it against the seal, classify
  the residual, subtract excess, update the owning state record, and stop lawfully.

  Unknown != Negative. Generated != Actual != Checked != Warranted.
  Semantic coverage != execution coverage. Fiber != selected return.
  Ledger order != causal order. No self-warrant.

Exact live frontier block:
${BLOCK}

Ledger:
${STATUS}"

printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$(printf '%s' "$CONTEXT" |
        sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' |
        awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; print }')"
