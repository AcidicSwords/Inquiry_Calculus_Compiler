#!/usr/bin/env bash
# ic-inject -- inject only the one generated inquiry-spine projection.

set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cat >/dev/null

if CONTEXT="$(node "$HERE/ic-spine.js" context "$ROOT" 2>&1)"; then
    :
else
    CONTEXT="INQUIRY SPINE INVALID: ${CONTEXT#ic-spine: }"
fi

printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$(printf '%s' "$CONTEXT" |
        sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' |
        awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; print }')"
