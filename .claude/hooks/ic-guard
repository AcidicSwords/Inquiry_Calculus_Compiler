#!/usr/bin/env bash
# ic-guard -- PreToolUse mutation and control-authority gate.
#
# This gate cannot widen host permissions. It denies ordinary mutations without an
# open prediction cycle and denies protected control mutations without a current,
# explicit user-authorized control record.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
PAYLOAD="$(cat)"

field() { printf '%s' "$PAYLOAD" | awk -v want="$1" -f "$HERE/ic-json.awk"; }

deny() {
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$(printf '%s' "$1" |
            sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' |
            awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; print }')"
    exit 0
}

allow() { exit 0; }
norm() { printf '%s' "$1" | tr 'A-Z\\' 'a-z/'; }

if ! printf '%s' "$PAYLOAD" | node -e '
    const fs = require("node:fs");
    try {
      const value = JSON.parse(fs.readFileSync(0, "utf8"));
      if (value === null || Array.isArray(value) || typeof value !== "object") {
        process.exit(1);
      }
    } catch {
      process.exit(1);
    }
  '; then
    deny "Malformed hook payload; the inquiry gate cannot establish the requested operation."
fi

ROOT_NORM="$(norm "$ROOT")"

protected_groups() {
    local p
    p="$(norm "$1")"
    case "$p" in
        *".claude/hooks"*|*".claude/settings"*|*".claude/skills/inquire"*)
            printf '%s\n' harness ;;
    esac
    case "$p" in
        *"inquiry_calculus_v2_0.tex"*) printf '%s\n' canonical ;;
        *"inquiry_calculus_v2_0_comprehensive_implementation_plan.md"*) printf '%s\n' plan ;;
    esac
    case "$p" in
        *".github/workflows"*|*"tools/docs_control_check.py"*|*"tools/harness_control_check.js"*)
            printf '%s\n' ci ;;
    esac
    case "$p" in
        *"agents.md"*) printf '%s\n' agents ;;
    esac
}

cycle_open() { bash "$HERE/ic-trace" open >/dev/null 2>&1; }
control_open() { bash "$HERE/ic-trace" control-open "$1" >/dev/null 2>&1; }

touches_trace_storage() {
    case "$(norm "$1")" in
        *".claude/trace"*) return 0 ;;
    esac
    return 1
}

is_direct_trace_command() {
    local command="$1" stripped executable remainder executable_norm
    case "$command" in
        *';'*|*'&'*|*'|'*|*'>'*|*'<'*|*$'\x60'*|*'$('*|*$'\n'*) return 1 ;;
    esac
    stripped="$(printf '%s' "$command" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    case "$stripped" in
        bash\ *|bash.exe\ *) stripped="${stripped#* }" ;;
    esac
    executable="${stripped%%[[:space:]]*}"
    [ "$executable" != "$stripped" ] || return 1
    remainder="${stripped#"$executable"}"
    executable_norm="$(norm "$executable")"
    case "$executable_norm" in
        .claude/hooks/ic-trace|./.claude/hooks/ic-trace|"$ROOT_NORM/.claude/hooks/ic-trace") ;;
        *) return 1 ;;
    esac
    [[ "$remainder" =~ ^[[:space:]]+(init|status|open|stop-pending|control-open|ensure|question|seal|raw|check|residual|stop|note|control|policy-transition|route)([[:space:]].*)?[[:space:]]*$ ]]
}

is_trace_execution_attempt() {
    local command="$1"
    [[ "$command" =~ ^[[:space:]]*((bash|bash\.exe|sh|env|command)[[:space:]]+)*[^[:space:]]*ic-trace([[:space:]]|$) ]]
}

is_append_execution_attempt() {
    local command="$1"
    [[ "$command" =~ ^[[:space:]]*(env[[:space:]]+|command[[:space:]]+)?node([.]exe)?[[:space:]]+[^[:space:]]*ic-append[.]js([[:space:]]|$) ]]
}

is_read_only_command() {
    local command="$1"
    case "$command" in
        *';'*|*'&'*|*'|'*|*'>'*|*'<'*|*$'\x60'*|*'$('*|*$'\n'*) return 1 ;;
    esac
    case "$command" in
        *" --pre"*|*" --hostname-bin"*) return 1 ;;
        *" -delete"*|*" -exec"*|*" -execdir"*|*" -ok"*|*" -okdir"*|*" -fprintf"*|*" -fprint"*|*" -fls"*) return 1 ;;
        *" --output"*|*" --ext-diff"*|*" --textconv"*) return 1 ;;
    esac
    if [[ "$command" =~ ^[[:space:]]*git[[:space:]]+branch([[:space:]].*)?[[:space:]]*$ ]]; then
        [[ "$command" =~ ^[[:space:]]*git[[:space:]]+branch([[:space:]]+(--show-current|--list|-a|-r|-v|-vv))*[[:space:]]*$ ]]
        return
    fi
    if [[ "$command" =~ ^[[:space:]]*git[[:space:]]+remote([[:space:]].*)?[[:space:]]*$ ]]; then
        [[ "$command" =~ ^[[:space:]]*git[[:space:]]+remote([[:space:]]+-v|[[:space:]]+(get-url|show)([[:space:]]+[^[:space:]]+)*)?[[:space:]]*$ ]]
        return
    fi
    [[ "$command" =~ ^[[:space:]]*(pwd|ls|dir|rg|grep|find|head|tail|wc|type|which|where|Get-Content|Get-ChildItem|Select-String|Test-Path|git[[:space:]]+(status|diff|show|log|rev-parse|ls-files)|node[[:space:]]+--check|bash(\.exe)?[[:space:]]+-n|cargo[[:space:]]+fmt[[:space:]]+--all[[:space:]]+--check|python(3)?[[:space:]]+tools/docs_control_check\.py)([[:space:]].*)?[[:space:]]*$ ]]
}

cycle_open_or_deny() {
    cycle_open || deny "$SEAL_MSG"
}

control_groups_open_or_deny() {
    local target="$1" group groups
    groups="$(protected_groups "$target" | sort -u)"
    [ -z "$groups" ] && return 0
    while IFS= read -r group; do
        [ -n "$group" ] || continue
        control_open "$group" || deny "$CONTROL_MSG"
    done <<<"$groups"
}

SEAL_MSG='No open inquiry cycle. This call would change actuality without a sealed prediction.

Seal the expected protected change first:

  .claude/hooks/ic-trace seal \
    should_change=... invariants=... discriminator=... wrong_impl=... coverage=...

After the return, append raw/check/residual records. Do not route around the gate.'

CONTROL_MSG='This call targets the repository execution harness or a protected authority file.

Such a change requires a current control record whose authority assertion and exact scope cover
this surface:

  .claude/hooks/ic-trace control \
    authority=user-request-reference \
    residual=named-control-residual \
    predecessor=current-authority \
    scope=exact-protected-paths

The record is auditable evidence of the asserted user authority; the harness does not manufacture
or cryptographically prove that authority. An autonomous candidate may not relax its own
acceptance path.'

TRACE_MSG='Direct rewriting of .claude/trace is forbidden. The engineering trace is append-only.

Use one direct .claude/hooks/ic-trace command. Preserve malformed historical traces and initialize
a new trace instead of rewriting ancestry.'

HELPER_MSG='ic-append.js is an internal trace primitive and may be reached only through ic-trace.'

TOOL="$(field tool_name)"

case "$TOOL" in
Edit|Write|NotebookEdit)
    TARGET="$(field tool_input.file_path)"
    [ -n "$TARGET" ] || TARGET="$(field tool_input.notebook_path)"
    [ -n "$TARGET" ] || deny "Malformed mutation request: no target path was supplied."
    cycle_open_or_deny
    touches_trace_storage "$TARGET" && deny "$TRACE_MSG"
    control_groups_open_or_deny "$TARGET"
    allow
    ;;

Bash)
    CMD="$(field tool_input.command)"
    [ -n "$CMD" ] || deny "Malformed shell request: no command was supplied."

    # Ledger operations remain reachable, but only as one direct trace invocation.
    # A comment or second shell command containing "ic-trace" is not an exemption.
    is_direct_trace_command "$CMD" && allow

    is_trace_execution_attempt "$CMD" && deny "$TRACE_MSG"
    is_append_execution_attempt "$CMD" && deny "$HELPER_MSG"
    is_read_only_command "$CMD" && allow

    # Every unclassified shell command is treated as consequential. This closes
    # writer-by-omission bypasses while preserving a small explicit read-only set.
    cycle_open_or_deny
    touches_trace_storage "$CMD" && deny "$TRACE_MSG"
    control_groups_open_or_deny "$CMD"
    allow
    ;;

*)
    deny "Unsupported or malformed mutation request; the inquiry gate cannot establish its target."
    ;;
esac
