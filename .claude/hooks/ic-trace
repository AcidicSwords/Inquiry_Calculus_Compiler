#!/usr/bin/env bash
# ic-trace -- append-only engineering inquiry evidence.
#
# The trace is a derived engineering record, not semantic event history. It preserves
# sealed predictions, safe raw returns, checks, residuals, and occurrence-aware recurrence
# fingerprints for clients that honor the repository harness.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TRACE_DIR="$ROOT/.claude/trace"
RAW_DIR="$TRACE_DIR/raw"
STATE="$TRACE_DIR/.state"
FUEL="$TRACE_DIR/.fuel"
DEFAULT_FUEL=24

RESIDUAL_CLASSES="none persists regression wrong_locus missing_dep weak_discriminator env_failure unknown resource"
STOP_STATES="Satisfied Equivalent Impossible Blocked Unknown ResourceBounded"
MODES="Pure Generate Probe Check Warrant"
RESOLUTIONS="Supported Partial Plural ExactEmpty Unsupported Unknown Blocked ResourceBounded"

die() { printf 'ic-trace: %s\n' "$*" >&2; exit 1; }

esc() {
    printf '%s' "$1" |
        sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' |
        awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; print }'
}

in_list() {
    local needle="$1" item
    shift
    for item in $1; do
        [ "$item" = "$needle" ] && return 0
    done
    return 1
}

trace_file() {
    [ -f "$STATE" ] || die "no trace; run: .claude/hooks/ic-trace init <slug>"
    local name
    name="$(cat "$STATE")"
    case "$name" in
        *[!A-Za-z0-9._-]*|'') die "invalid trace state filename" ;;
    esac
    printf '%s' "$TRACE_DIR/$name"
}

validate_trace() {
    node "$ROOT/.claude/hooks/ic-append.js" validate "$1" >/dev/null ||
        die "active trace failed structural validation"
}

read_lifecycle() {
    lifecycle_json="$(node "$ROOT/.claude/hooks/ic-append.js" state "$1")" ||
        die "active trace failed lifecycle validation"
}

lifecycle_value() {
    printf '%s' "$lifecycle_json" | node -e '
const fs = require("fs");
const value = JSON.parse(fs.readFileSync(0, "utf8"))[process.argv[1]];
process.stdout.write(String(value ?? ""));
' "$1"
}

last_line_of_kind() {
    local f="$1" kind="$2"
    grep -n "\"kind\":\"$kind\"" "$f" 2>/dev/null | tail -1 | cut -d: -f1
}

frontier_context() {
    local f="$ROOT/IMPLEMENTATION_FRONTIER.md"
    [ -f "$f" ] || die "IMPLEMENTATION_FRONTIER.md is missing"
    node "$ROOT/.claude/hooks/ic-frontier.js" "$f" context ||
        die "IMPLEMENTATION_FRONTIER.md live block failed exact schema validation"
}

repository_actuality() {
    {
        git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf 'no-head\n'
        git -C "$ROOT" diff --binary --no-ext-diff HEAD -- 2>/dev/null || true
        git -C "$ROOT" ls-files --others --exclude-standard -z 2>/dev/null |
            while IFS= read -r -d '' rel; do
                printf 'UNTRACKED\0%s\0' "$rel"
                sha256sum "$ROOT/$rel" 2>/dev/null || printf 'unreadable\n'
            done
    } | sha256sum | cut -c1-24
}

normalize_coordinate() {
    printf '%s' "$1" | node "$ROOT/.claude/hooks/ic-coordinate.js" ||
        die "cannot normalize recurrence coordinate"
}

fingerprint() {
    local q="$1" occurrence="$2" continuation="$3" bindings="$4"
    local horizon="$5" coverage="$6" authority="$7" evidence="$8"
    local frontier_id frontier_hash actuality
    IFS=$'\t' read -r frontier_id frontier_hash <<<"$(frontier_context)"
    actuality="$(repository_actuality)"
    printf '%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s' "$q" "$occurrence" "$continuation" "$bindings" "$frontier_id" "$frontier_hash" "$horizon" "$coverage" "$authority" "$evidence" "$actuality" |
        sha256sum | cut -c1-24
}

cmd="${1:-}"
[ -n "$cmd" ] || die "usage: ic-trace <init|status|state|open|mutation-open|stop-pending|control-open|resume|KIND> [k=v ...]"
shift || true
resume_requested=false

case "$cmd" in
init)
    predecessor_fields=""
    if [ -f "$STATE" ]; then
        current="$(trace_file 2>/dev/null || true)"
        if [ -n "$current" ] && node "$ROOT/.claude/hooks/ic-append.js" validate "$current" >/dev/null 2>&1; then
            read_lifecycle "$current"
            if [ "$(lifecycle_value open)" = "true" ]; then
                die "cannot initialize a new trace while the current sealed cycle is open"
            fi
            if [ "$(lifecycle_value can_initialize)" != "true" ]; then
                die "cannot initialize a new trace before the checked residual/task closure has a lawful stop"
            fi
            predecessor_fields=",\"predecessor_trace\":\".claude/trace/$(basename "$current")\",\"predecessor_trace_sha256\":\"$(lifecycle_value trace_sha256)\",\"predecessor_policy_schema\":\"$(lifecycle_value schema)\""
        fi
    fi
    mkdir -p "$TRACE_DIR"
    slug="${1:-session}"
    slug="${slug//[^A-Za-z0-9._-]/-}"
    created="$(mktemp "$TRACE_DIR/$(date +%Y%m%d-%H%M%S)-$slug.XXXXXX.jsonl")" ||
        die "cannot create trace"
    printf '%s' "$(basename "$created")" >"$STATE"
    printf '%s' "$DEFAULT_FUEL" >"$FUEL"
    source_digest="$(sha256sum "$ROOT/formal-successor/Questions.txt" 2>/dev/null | cut -d' ' -f1)"
    manifest_digest="$(sha256sum "$ROOT/formal-successor/ENGINEERING_QUESTION_PROGRAMS.json" 2>/dev/null | cut -d' ' -f1)"
    policy_schema="$(node -e 'const fs=require("fs"); const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.stdout.write(String(m.schema));' "$ROOT/formal-successor/ENGINEERING_QUESTION_PROGRAMS.json" 2>/dev/null)"
    [ "${#source_digest}" -eq 64 ] || die "cannot pin Questions.txt for the new trace"
    [ "${#manifest_digest}" -eq 64 ] || die "cannot pin engineering question programs for the new trace"
    [ -n "$policy_schema" ] || die "cannot read engineering question-program schema"
    policy_record="$(printf '{\"ts\":\"%s\",\"kind\":\"policy\",\"question_program_schema\":\"%s\",\"source_digest\":\"%s\",\"program_manifest_digest\":\"%s\"%s}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$policy_schema" "$source_digest" "$manifest_digest" "$predecessor_fields")"
    printf '%s\n' "$policy_record" |
        node "$ROOT/.claude/hooks/ic-append.js" append "$created" >/dev/null ||
        die "cannot initialize question-program policy"
    printf 'trace: .claude/trace/%s (fuel %s)\n' "$(basename "$created")" "$DEFAULT_FUEL"
    exit 0
    ;;
state)
    [ -f "$STATE" ] || { printf '{"schema":null,"open":false,"mutation_open":false,"stop_pending":false,"can_initialize":true}\n'; exit 0; }
    read_lifecycle "$(trace_file)"
    printf '%s\n' "$lifecycle_json"
    exit 0
    ;;
status)
    if [ ! -f "$STATE" ]; then
        printf 'no trace\n'
        exit 0
    fi
    f="$(trace_file)"
    read_lifecycle "$f"
    printf 'file    : .claude/trace/%s\n' "$(cat "$STATE")"
    printf 'records : %s\n' "$(wc -l <"$f" | tr -d ' ')"
    printf 'fuel    : %s\n' "$(cat "$FUEL" 2>/dev/null || printf '?')"
    if [ "$(lifecycle_value open)" = "true" ]; then
        printf 'cycle   : OPEN (validated lifecycle has unresolved work)\n'
    else
        printf 'cycle   : closed\n'
    fi
    printf 'mutation: %s\n' "$(lifecycle_value mutation_open)"
    printf 'stop pending: %s\n' "$(lifecycle_value stop_pending)"
    if bash "$0" control-open >/dev/null 2>&1; then
        printf 'control : authorized for current cycle\n'
    else
        printf 'control : closed\n'
    fi
    exit 0
    ;;
open|mutation-open)
    [ -f "$STATE" ] || exit 1
    f="$(trace_file)"
    read_lifecycle "$f"
    key="open"
    [ "$cmd" != "mutation-open" ] || key="mutation_open"
    [ "$(lifecycle_value "$key")" = "true" ]
    exit
    ;;
stop-pending)
    [ -f "$STATE" ] || exit 1
    f="$(trace_file)"
    read_lifecycle "$f"
    [ "$(lifecycle_value stop_pending)" = "true" ]
    exit
    ;;
control-open)
    [ -f "$STATE" ] || exit 1
    f="$(trace_file)"
    validate_trace "$f"
    wanted="${1:-}"
    read_lifecycle "$f"
    if [ "$(lifecycle_value schema)" = "4" ]; then
        printf '%s' "$lifecycle_json" | node -e '
const fs=require("fs"), control=JSON.parse(fs.readFileSync(0,"utf8")).control;
const wanted=process.argv[1];
process.exit(control && /user|human/i.test(control.authority) &&
  (!wanted || control.scope.toLowerCase().split(/[,;\s]+/).includes(wanted)) ? 0 : 1);
' "$wanted"
        exit
    fi
    last_control="$(last_line_of_kind "$f" control)"
    last_res="$(last_line_of_kind "$f" residual)"
    last_stop="$(last_line_of_kind "$f" stop)"
    last_close="${last_res:-0}"
    [ "${last_stop:-0}" -gt "$last_close" ] && last_close="$last_stop"
    [ -n "$last_control" ] && [ "$last_control" -gt "$last_close" ] || exit 1
    control_record="$(sed -n "${last_control}p" "$f")"
    control_scope="$(printf '%s' "$control_record" |
        awk -v want="scope" -f "$ROOT/.claude/hooks/ic-json.awk")"
    control_authority="$(printf '%s' "$control_record" |
        awk -v want="authority" -f "$ROOT/.claude/hooks/ic-json.awk")"
    authority_norm="$(printf '%s' "$control_authority" | tr 'A-Z' 'a-z')"
    case "$authority_norm" in *user*|*human*) ;; *) exit 1 ;; esac
    if [ -n "$wanted" ]; then
        scope_tokens="$(printf '%s' "$control_scope" |
            tr 'A-Z,;' 'a-z  ')"
        matched=false
        for scope_token in $scope_tokens; do
            [ "$scope_token" = "$wanted" ] && matched=true
        done
        [ "$matched" = "true" ] || exit 1
    fi
    exit 0
    ;;
policy-transition) cmd="policy_transition" ;;
resume) resume_requested=true; cmd="note" ;;
ensure|question|field|ask|seal|raw|interpret|check|answer|reify|invalidate|fold|reopen|residual|checkpoint|closure|stop|note|control|route) ;;
*) die "unknown kind '$cmd'" ;;
esac

f="$(trace_file)"
validate_trace "$f"
active_schema="$(node -e '
const fs=require("fs");
const records=fs.readFileSync(process.argv[1],"utf8").trimEnd().split(/\r?\n/).filter(Boolean).map(JSON.parse);
const policy=records.filter((record)=>record.kind==="policy"||record.kind==="policy_transition").at(-1);
process.stdout.write(String(policy?.question_program_schema??""));
' "$f")" || die "cannot read active trace schema"
declare -A kv=()
for arg in "$@"; do
    case "$arg" in
    *=*) kv["${arg%%=*}"]="${arg#*=}" ;;
    *) die "argument '$arg' is not key=value" ;;
    esac
done

if [ "$resume_requested" = "true" ]; then
    bash "$0" control-open harness >/dev/null 2>&1 ||
        die "checkpoint continuation requires current user-authorized harness control"
    read_lifecycle "$f"
    [ "$(lifecycle_value open)" = "false" ] || die "checkpoint continuation requires a closed local lifecycle"
    kv[event]="checkpoint_resume"
    kv[field_id]="$(lifecycle_value field_id)"
    kv[checkpoint]="$(lifecycle_value last_checkpoint)"
    kv[fuel_grant]="$DEFAULT_FUEL"
    kv[authority]="user-authorized harness control"
    kv[remaining_open]="live Productive/Required executable field members"
    kv[text]="continue from checkpoint ${kv[checkpoint]} without claiming task closure or changing semantic priority"
fi

if [ "$cmd" = "ask" ]; then
    kv[source_digest]="$(sha256sum "$ROOT/formal-successor/Questions.txt" | cut -d' ' -f1)"
    kv[program_manifest_digest]="$(sha256sum "$ROOT/formal-successor/ENGINEERING_QUESTION_PROGRAMS.json" | cut -d' ' -f1)"
fi

if [ "$cmd" = "residual" ]; then
    topology_context="$(node "$ROOT/.claude/hooks/ic-residual-topology.js" context "$ROOT")" ||
        die "cannot validate broad residual topology"
    IFS=$'\t' read -r topology_digest topology_active topology_counts <<<"$topology_context"
    kv[residual_topology_digest]="$topology_digest"
    kv[active_residual]="$topology_active"
    kv[unresolved_field]="$topology_counts"
    kv[closure_scope]="local_obligation_binding_horizon_coverage_not_global_exhaustion"
fi

if [ "$cmd" = "policy_transition" ]; then
    bash "$0" control-open harness >/dev/null 2>&1 ||
        die "question-program policy transition requires current user-authorized harness control"
    prior_policy="$(node -e '
const fs=require("fs");
const records=fs.readFileSync(process.argv[1],"utf8").trimEnd().split(/\r?\n/).filter(Boolean).map(JSON.parse);
const policy=records.filter((record)=>record.kind==="policy"||record.kind==="policy_transition").at(-1);
if (!policy) process.exit(1);
process.stdout.write([policy.source_digest,policy.program_manifest_digest].join("\t"));
' "$f")" || die "cannot read predecessor question-program policy"
    IFS=$'\t' read -r prior_source_digest prior_manifest_digest <<<"$prior_policy"
    kv[predecessor_source_digest]="$prior_source_digest"
    kv[predecessor_program_manifest_digest]="$prior_manifest_digest"
    kv[source_digest]="$(sha256sum "$ROOT/formal-successor/Questions.txt" | cut -d' ' -f1)"
    kv[program_manifest_digest]="$(sha256sum "$ROOT/formal-successor/ENGINEERING_QUESTION_PROGRAMS.json" | cut -d' ' -f1)"
    kv[question_program_schema]="$(node -e 'const fs=require("fs"); const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.stdout.write(String(m.schema));' "$ROOT/formal-successor/ENGINEERING_QUESTION_PROGRAMS.json")"
fi

need() {
    local k
    for k in "$@"; do
        [ -n "${kv[$k]:-}" ] || die "kind '$cmd' requires non-empty $k="
    done
}

case "$cmd" in
ensure) need task authority invariants ;;
question)
    [ "$active_schema" != "4" ] || die "schema 4 uses separate field, ask, answer, and reify records"
    need q mode answer branch occurrence continuation bindings horizon coverage authority evidence \
        program rhythm residual_class compiled_questions question_families coding_questions \
        coverage_dimensions root_spans rhythm_positions reciprocal_status \
        reciprocal_challenges blocked_reciprocals reciprocal_pairs reciprocal_axes reciprocal_reason \
        parent_residual condition_ids breaker_ids reciprocal_obligation \
        question_disposition residual_shape method_frontier condition_keys \
        source_digest program_manifest_digest
    in_list "${kv[mode]}" "$MODES" || die "mode must be one of: $MODES"
    ;;
field) need field_id members basis coverage regenerated_from dispositions removal_evidence ;;
ask)
    [ "$active_schema" = "4" ] || die "explicit Ask records require schema 4"
    need q mode occurrence field_id question_form rendering source_lines generator_ids \
        reciprocal_relations path bindings horizon coverage authority evidence dependencies \
        source_digest program_manifest_digest
    in_list "${kv[mode]}" "$MODES" || die "mode must be one of: $MODES"
    ;;
seal)
    need should_change invariants discriminator wrong_impl coverage
    [ "$active_schema" != "4" ] || need ask_occurrence
    ;;
raw)
    need cmd
    [ "$active_schema" != "4" ] || need ask_occurrence
    ;;
interpret) need ask_occurrence raw_digest interpretation provenance ;;
check)
    need verdict coverage
    [ "$active_schema" != "4" ] || need ask_occurrence evidence
    ;;
answer)
    need occurrence ask_occurrence answer resolution_class status polarity residual evidence coverage authority
    in_list "${kv[resolution_class]}" "$RESOLUTIONS" || die "resolution_class must be one of: $RESOLUTIONS"
    ;;
reify) need answer_occurrence status products new_questions coverage ;;
invalidate) need product_ids cause evidence ;;
fold) need fold_id members representative protected_equivalence_evidence regeneration reopen_condition horizon coverage ;;
reopen) need fold_id restored_members discriminator evidence ;;
residual)
    need class next parent_residual open_relation condition_ids blocker_ids breaker_ids \
        condition_keys separator_ids survived_contrast_ids conflict_ids gap_ids failed_fold_ids \
        reopen_condition_ids overlap_ids coverage resolution_class residual_topology_digest \
        active_residual unresolved_field closure_scope
    if [ "$active_schema" != "4" ]; then
        need residual_shape method_frontier next_question_family
    fi
    in_list "${kv[class]}" "$RESIDUAL_CLASSES" ||
        die "class must be one of: $RESIDUAL_CLASSES"
    in_list "${kv[resolution_class]}" "$RESOLUTIONS" ||
        die "resolution_class must be one of: $RESOLUTIONS"
    ;;
checkpoint) need field_id established remains_open fold_changes reopen_changes coverage ;;
closure) need field_id scope warrant adversarial_question adversarial_answer coverage ;;
stop)
    need state warrant
    in_list "${kv[state]}" "$STOP_STATES" || die "state must be one of: $STOP_STATES"
    if [ "${kv[state]}" = "Satisfied" ]; then
        warrant_norm="$(printf '%s' "${kv[warrant]}" | tr 'A-Z' 'a-z' | tr -d '[:space:]')"
        case "$warrant_norm" in
            ''|none|none:*|none-*|self|self:*|self-*|agent|agent:*|agent-*|generated|generated:*|generated-*)
                die "Satisfied requires a non-self warrant reference" ;;
        esac
    fi
    ;;
note)
    if [ "${kv[event]:-}" = "checkpoint_resume" ]; then
        need field_id checkpoint fuel_grant authority reason remaining_open text
    else
        need text
    fi
    ;;
control) need authority residual predecessor scope ;;
policy_transition) need authority reason predecessor_source_digest \
    predecessor_program_manifest_digest source_digest program_manifest_digest \
    question_program_schema ;;
route) need source_occurrence answer successor_occurrence provenance ;;
esac

if [ "$cmd" = "residual" ] && [ "$active_schema" != "4" ]; then
    node -e '
const policy = require(process.argv[1]);
const expected = policy.chooseMethodFrontier(process.argv[2]).join(",");
if (process.argv[3] !== expected) {
  throw new Error(`method_frontier must exactly report ${expected}`);
}
const keys = process.argv[4];
const pattern = /^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@(forward|reverse|neutral)(?:;[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@[A-Za-z0-9._-]+@(forward|reverse|neutral))*$/u;
if (keys !== "none" && !pattern.test(keys)) throw new Error("condition_keys has invalid normalized identity");
' "$ROOT/.claude/hooks/ic-construction-policy.js" "${kv[residual_shape]}" \
        "${kv[method_frontier]}" "${kv[condition_keys]}" ||
        die "residual shape, method frontier, or condition identity is invalid"
fi

if [ "$cmd" = "raw" ]; then
    sensitive="${kv[sensitive]:-false}"
    [ "$sensitive" = "true" ] || [ "$sensitive" = "false" ] ||
        die "raw sensitive= must be true or false"
    if [ -n "${kv[file]:-}" ]; then
        [ -f "${kv[file]}" ] || die "raw file '${kv[file]}' does not exist"
        # Hash bytes through stdin: GNU filename escaping otherwise prefixes the
        # digest with a backslash for native Windows/backslash-containing paths.
        kv[digest]="$(sha256sum <"${kv[file]}" | cut -d' ' -f1)"
        if [ "$sensitive" = "false" ]; then
            mkdir -p "$RAW_DIR"
            target="$RAW_DIR/${kv[digest]}"
            if [ -f "$target" ]; then
                cmp -s "${kv[file]}" "$target" || die "raw digest collision"
            else
                cp -- "${kv[file]}" "$target" || die "cannot preserve raw return"
                chmod 600 "$target" 2>/dev/null || true
            fi
            kv[raw_ref]=".claude/trace/raw/${kv[digest]}"
        else
            kv[raw_ref]="digest-only:sensitive"
        fi
        unset 'kv[file]'
    else
        need digest
        [ "$sensitive" = "true" ] ||
            die "digest-only raw records require sensitive=true"
        case "${kv[digest]}" in
            *[!0-9a-fA-F]*|'') die "sensitive digest must be exactly 64 hexadecimal SHA-256 characters" ;;
        esac
        [ "${#kv[digest]}" -eq 64 ] ||
            die "sensitive digest must be exactly 64 hexadecimal SHA-256 characters"
        kv[digest]="$(printf '%s' "${kv[digest]}" | tr 'A-F' 'a-f')"
        kv[raw_ref]="digest-only:sensitive"
    fi
    kv[sensitive]="$sensitive"
fi

fp=""
if [ "$cmd" = "question" ]; then
    kv[bindings_normalized]="$(normalize_coordinate "${kv[bindings]}")"
    kv[horizon_normalized]="$(normalize_coordinate "${kv[horizon]}")"
    kv[coverage_normalized]="$(normalize_coordinate "${kv[coverage]}")"
    kv[authority_normalized]="$(normalize_coordinate "${kv[authority]}")"
    kv[evidence_normalized]="$(normalize_coordinate "${kv[evidence]}")"
    q_program_context="${kv[q]}|${kv[program]}|${kv[rhythm]}|${kv[residual_class]}|${kv[compiled_questions]}|${kv[question_families]}|${kv[coding_questions]}|${kv[coverage_dimensions]}|${kv[root_spans]}|${kv[rhythm_positions]}|${kv[reciprocal_status]}|${kv[reciprocal_challenges]}|${kv[blocked_reciprocals]}|${kv[reciprocal_pairs]}|${kv[reciprocal_axes]}|${kv[parent_residual]}|${kv[condition_ids]}|${kv[breaker_ids]}|${kv[reciprocal_obligation]}|${kv[question_disposition]}|${kv[residual_shape]}|${kv[method_frontier]}|${kv[condition_keys]}|${kv[source_digest]}|${kv[program_manifest_digest]}"
    fp="$(fingerprint "$q_program_context" "${kv[occurrence]}" "${kv[continuation]}" "${kv[bindings_normalized]}" "${kv[horizon_normalized]}" "${kv[coverage_normalized]}" "${kv[authority_normalized]}" "${kv[evidence_normalized]}")"
fi
if [ "$cmd" = "ask" ]; then
    kv[bindings_normalized]="$(normalize_coordinate "${kv[bindings]}")"
    kv[horizon_normalized]="$(normalize_coordinate "${kv[horizon]}")"
    kv[coverage_normalized]="$(normalize_coordinate "${kv[coverage]}")"
    kv[authority_normalized]="$(normalize_coordinate "${kv[authority]}")"
    kv[evidence_normalized]="$(normalize_coordinate "${kv[evidence]}")"
    ask_context="${kv[q]}|${kv[field_id]}|${kv[question_form]}|${kv[rendering]}|${kv[source_lines]}|${kv[generator_ids]}|${kv[reciprocal_relations]}|${kv[path]}|${kv[dependencies]}|${kv[source_digest]}|${kv[program_manifest_digest]}"
    fp="$(fingerprint "$ask_context" "${kv[occurrence]}" field-regeneration "${kv[bindings_normalized]}" "${kv[horizon_normalized]}" "${kv[coverage_normalized]}" "${kv[authority_normalized]}" "${kv[evidence_normalized]}")"
fi

record="$({
    printf '{"ts":"%s","kind":"%s"' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$cmd"
    [ -n "$fp" ] && printf ',"fp":"%s"' "$fp"
    for k in "${!kv[@]}"; do
        printf ',"%s":"%s"' "$(esc "$k")" "$(esc "${kv[$k]}")"
    done
    printf '}\n'
})"
if [ "$cmd" = "question" ] || [ "$cmd" = "ask" ] || { [ "$cmd" = "note" ] && [ "${kv[event]:-}" = "checkpoint_resume" ]; }; then
    seq="$(printf '%s\n' "$record" |
        node "$ROOT/.claude/hooks/ic-append.js" append "$f" "$FUEL")" ||
        die "validated trace append failed"
else
    seq="$(printf '%s\n' "$record" |
        node "$ROOT/.claude/hooks/ic-append.js" append "$f")" ||
        die "validated trace append failed"
fi

printf 'ic-trace: %s #%s appended\n' "$cmd" "$seq"
